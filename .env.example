# =============================================================================
# CyaneHub — Environment variables
# =============================================================================
# Copy this file to `.env` and fill in the values for your own Supabase project
# (either Supabase Cloud at https://supabase.com or a self-hosted instance).
#
# The app reads these at build time (VITE_*) and at runtime on the server
# (the unprefixed versions). You need BOTH sets when self-hosting.
# =============================================================================

# ---- Client (browser) -- safe to ship, embedded in the JS bundle by Vite ----
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# ---- Server (SSR / server functions) -- same values, no VITE_ prefix --------
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# ---- Server secret -- NEVER expose to the client / commit to git ------------
# Found in Supabase dashboard -> Project Settings -> API -> service_role key.
# Required for admin operations (bypasses Row Level Security).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
